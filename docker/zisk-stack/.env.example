# Copy to .env next to compose.yaml and edit.

# Sequencer prover API. Basic auth goes in the URL: http://user:pass@host:3124
ZISK_SEQUENCER_URL=http://sequencer:3124

# The stack image. Release images carry the release tag; `latest` tracks main.
ZISK_STACK_TAG=latest
# Or pin the image explicitly:
# ZISK_STACK_IMAGE=ghcr.io/matter-labs/zksync-os-zisk-prover:0.0.6

# Which GPU the worker uses. One worker per GPU; copy the service for more.
CUDA_VISIBLE_DEVICES=0

# Identity reported to the sequencer's job API.
ZISK_PROVER_ID=zisk-stack

# Key fetch. Set to 1 only to accept a PENDING sha256 pin (md5 check alone);
# the run prints the digest to record in docker/zisk-stack/keys.sha256.
ZISK_KEYS_ALLOW_UNPINNED=0

# Shared memory for the worker; raise for very large batches on the ASM path.
ZISK_WORKER_SHM_SIZE=8gb

RUST_LOG=info
